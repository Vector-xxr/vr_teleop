# Copy to: left_job_orchestrator/env.systemd
#   cp boot_autostart_left_job/env.systemd.example left_job_orchestrator/env.systemd
#   chmod 600 left_job_orchestrator/env.systemd
#
# Referenced by: /etc/systemd/system/openarm-left-job.service
#   EnvironmentFile=/home/knowin/Desktop/vr_control/left_job_orchestrator/env.systemd

# REQUIRED on the target machine. Installer refuses --enable/--start unchanged.
OPENARM_SUDO_PASSWORD=CHANGE_ME
OPENARM_LEFT_JOB_API_TOKEN=openarm-job-api

# Plain TCP (default). Set to 1 only if clients use TLS.
OPENARM_LEFT_JOB_TLS=0
OPENARM_CAN_WAIT_TIMEOUT_S=60

# Required runtime paths. systemd does not inherit an interactive shell's
# sourced ROS environment; run_service.sh and check_service_env.sh source this.
OPENARM_ROS_SETUP=/opt/ros/humble/setup.bash

# Optional overrides:
# install.sh writes OPENARM_PYTHON automatically; use --python for nonstandard conda paths.
# OPENARM_SKEWER_JOB_LISTEN_PORT=47925
# OPENARM_SKEWER_JOBS_ROOT=/home/knowin/Desktop/vr_control/openarm_teleop/openarm_inplace/recordings
# OPENARM_LEFT_JOB_REQUIRE_AUTH=1
